{
  "name": "agent-signal",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "node scripts/install-ci.mjs",
    "dev": "node scripts/run-framework.mjs dev",
    "build": "node scripts/run-framework.mjs build",
    "start": "node --import ./scripts/sites-env.mjs ./node_modules/wrangler/bin/wrangler.js dev --config dist/server/wrangler.json --local --persist-to .wrangler/state --ip 127.0.0.1 --inspector-port 0",
    "lint": "eslint . --max-warnings 0",
    "db:generate": "drizzle-kit generate",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.tests.json --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "format:check": "prettier --check .",
    "verify": "npm run format:check && npm run architecture && npm run lint && npm run lint:shell && npm run typecheck && npm run test:skips && npm test",
    "architecture": "node tools/devkit/architecture.mjs && node scripts/check-source.mjs",
    "test:skips": "python3 tools/devkit/skipped_tests.py",
    "lint:shell": "shellcheck scripts/*.sh",
    "audit:dependencies": "node scripts/dependency-audit.mjs"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.3.6",
    "proper-lockfile": "4.1.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.63.0",
    "@cloudflare/workers-types": "5.20261007.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.34",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.6",
    "json-rpc-2.0": "1.7.1",
    "prettier": "3.9.9",
    "raw-body": "3.0.2",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "vinext": "1.0.1",
    "vite": "8.3.3",
    "wrangler": "4.148.0"
  },
  "type": "module",
  "overrides": {
    "miniflare": {
      "sharp": "0.35.5"
    },
    "satori": {
      "fflate": "0.7.5"
    }
  },
  "license": "MIT"
}
