{
  "name": "agent-signal",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node node_modules/wrangler/bin/wrangler.js dev --config wrangler.cloudflare.json --local --persist-to .wrangler/state --ip 127.0.0.1",
    "build": "node scripts/build-worker.mjs",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.tests.json --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "format:check": "prettier --check .",
    "verify": "npm run format:check && npm run docs:check && npm run architecture && npm run unused && npm run lint && npm run typecheck && npm run test:skips && npm test",
    "architecture": "node tools/devkit/architecture.mjs && node scripts/check-source.mjs",
    "test:skips": "python3 tools/devkit/skipped_tests.py",
    "audit:dependencies": "node scripts/dependency-audit.mjs",
    "test:worker": "npm run build && node scripts/direct-worker-smoke.mjs",
    "unused": "knip",
    "docs:check": "node scripts/check-docs.mjs"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@types/node": "22.19.19",
    "@typescript-eslint/eslint-plugin": "8.71.1",
    "@typescript-eslint/parser": "8.71.1",
    "eslint": "9.39.4",
    "globals": "14.0.0",
    "knip": "6.40.0",
    "miniflare": "5.20261006.0-alpha",
    "prettier": "3.9.9",
    "typescript": "5.9.3",
    "wrangler": "4.148.0"
  },
  "type": "module",
  "overrides": {
    "miniflare": {
      "sharp": "0.35.5"
    }
  },
  "license": "MIT"
}
