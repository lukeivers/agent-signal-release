{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "core/cloudflare-worker.ts",
        "scripts/cloudflare.mjs",
        "scripts/install-codex-hook.mjs",
        "scripts/uninstall-codex-hook.mjs",
        "tests/**/*.test.ts"
      ],
      "project": ["**/*.{ts,mjs}"]
    },
    "clients/codex": {
      "entry": ["hook.mjs", "new-capability.mjs"],
      "project": ["**/*.mjs"]
    }
  }
}
