{
  "components": ["app", "build", "clients", "core", "db", "lib", "scripts", "tests"],
  "rootFiles": [
    "cloudflare-env.d.ts",
    "drizzle.config.ts",
    "eslint.config.mjs",
    "next.config.ts",
    "postcss.config.mjs",
    "vite.config.ts"
  ],
  "excluded": [
    "tools/devkit",
    "scripts/build-verified.sh",
    "scripts/install-ci.sh",
    "scripts/install-pnpm.sh",
    "scripts/sites-env.sh"
  ],
  "unscannedExtensions": [".css"],
  "aliases": {
    "@/": ""
  },
  "externals": ["virtual:", "cloudflare:"],
  "clones": {
    "minTokens": 50,
    "minLines": 5,
    "minDistinctTokens": 12
  },
  "boundaries": [
    {
      "concern": "portable core cannot depend on UI, client or hosting layers",
      "from": ["core"],
      "forbid": ["app", "clients", "build", "next", "react"]
    }
  ],
  "owners": {
    "cohort validation": {
      "owner": "core/contract.ts",
      "names": ["cohort", "cohortKey"]
    },
    "capability validation": {
      "owner": "core/contract.ts",
      "names": ["identity"]
    },
    "report storage": {
      "owner": "core/store.ts",
      "names": ["Store"]
    }
  },
  "sameName": {}
}
