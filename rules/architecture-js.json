{
  "components": ["clients", "core", "scripts", "tests"],
  "rootFiles": ["eslint.config.mjs"],
  "excluded": ["tools/devkit"],
  "unscannedExtensions": [],
  "aliases": {},
  "externals": [],
  "clones": {
    "minTokens": 50,
    "minLines": 5,
    "minDistinctTokens": 12
  },
  "boundaries": [
    {
      "concern": "portable core cannot depend on UI, client or hosting layers",
      "from": ["core"],
      "forbid": ["app", "clients", "build", "next", "react"]
    }
  ],
  "owners": {
    "cohort validation": {
      "owner": "core/contract.ts",
      "names": ["cohort", "cohortKey"]
    },
    "capability validation": {
      "owner": "core/contract.ts",
      "names": ["identity"]
    },
    "report storage": {
      "owner": "core/store.ts",
      "names": ["Store"]
    }
  },
  "sameName": {}
}
